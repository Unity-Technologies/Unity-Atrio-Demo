/* InspectorCard: a collapsible panel whose header always carries a one-line summary, so a
   closed card still tells you what is inside. The body and arrow snap, like Unity's foldouts. */

/* Unity pads a custom inspector 15 px left, 6 px right and 2 px top, so cards sat off centre and
   hard against the component header. Even it out to 10 px on both sides and 8 px on top. */
.blocks-inspector {
    margin: 6px 4px 0 -5px;
}

/* Rounded, accent-filled buttons. Scoped to .blocks-inspector so any other surface that
   imports this sheet keeps Unity's default buttons. */
.blocks-inspector .unity-button {
    border-radius: 6px;
    transition-timing-function: ease-out;
}

.blocks-inspector .blocks-button--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-on);
    border-color: var(--color-accent);
    transition-property: background-color, border-color;
    transition-duration: 90ms;
}

.blocks-inspector .blocks-button--primary:hover {
    background-color: var(--color-accent-bright);
    color: var(--color-accent-on);
    border-color: var(--color-accent-bright);
}

.blocks-inspector .blocks-button--primary:active {
    background-color: var(--color-accent);
}

.blocks-panel {
    background-color: var(--color-card-background);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 10px;
    margin-bottom: 8px;
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 160ms;
}

.blocks-panel:hover {
    border-color: var(--color-border-subtle-strong);
}

.blocks-panel__header {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    padding: 0 10px 0 12px;
    transition-property: background-color;
    transition-duration: 120ms;
}

.blocks-panel--collapsible .blocks-panel__header:hover {
    background-color: var(--color-surface-subtle);
}

.blocks-panel__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-foreground-strong);
    margin-right: 10px;
    flex-shrink: 0;
}

/* A few words after the title saying what the card is about: "the box in the scene". */
.blocks-panel__gloss {
    font-size: 11px;
    color: var(--color-foreground-dim);
    margin-right: 8px;
    flex-shrink: 4;
    overflow: hidden;
    text-overflow: ellipsis;
}

.blocks-panel__summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    font-size: 11px;
    color: var(--color-foreground-muted);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    transition-property: color;
    transition-duration: 120ms;
}

.blocks-panel__header:hover .blocks-panel__summary {
    color: var(--color-foreground-secondary);
}

.blocks-panel__summary--warn {
    color: var(--color-warning-text);
}

.blocks-panel__actions {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.blocks-panel__action {
    height: 20px;
    padding: 0 8px;
    margin: 0 0 0 4px;
    font-size: 11px;
}

.blocks-panel__chevron {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    padding: 0;
    font-size: 13px;
    color: var(--color-foreground-dim);
    -unity-text-align: middle-center;
    transition-property: color;
    transition-duration: 120ms;
}

.blocks-panel--open .blocks-panel__chevron {
    rotate: 90deg;
}

/* Leading chevron: the chevron opens the row like a foldout and the summary keeps to the right.
   It draws Unity's own foldout arrow, so it matches the foldouts inside the card. */
.blocks-panel--leading .blocks-panel__chevron {
    width: 13px;
    height: 13px;
    margin-left: 0;
    margin-right: 8px;
    rotate: 0deg;
    background-image: var(--unity-icons-foldout);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-foreground-secondary);
}

/* With the summary at the right edge, the gloss gives way first as the header narrows, and a long
   summary (an object name) is capped instead of eating the gloss. */
.blocks-panel--leading .blocks-panel__gloss {
    flex-grow: 1;
    flex-shrink: 1000;
    min-width: 0;
}

.blocks-panel--leading .blocks-panel__summary {
    flex-grow: 0;
    flex-shrink: 1;
    max-width: 60%;
}

.blocks-panel--leading.blocks-panel--open .blocks-panel__chevron {
    rotate: 90deg;
}

.blocks-panel--leading .blocks-panel__summary {
    -unity-text-align: middle-right;
}

/* A summary row: no body, so no chevron. Its header may still act (jump to the component). */
.blocks-panel--static .blocks-panel__chevron {
    display: none;
}

.blocks-panel--static.blocks-panel--clickable .blocks-panel__header:hover {
    background-color: var(--color-surface-subtle);
}

.blocks-panel__header:hover .blocks-panel__chevron {
    color: var(--color-foreground);
}

.blocks-panel__body {
    padding: 6px 12px 12px 12px;
    border-top-width: 1px;
    border-top-color: var(--color-divider);
}

/* A footer stays on screen when the card is closed; it brings its own look. */
.blocks-panel__footer {
    flex-shrink: 0;
}

/* A small muted paragraph closing a card body. */
.blocks-panel__hint {
    color: var(--color-foreground-dim);
    font-size: 11px;
    white-space: normal;
    margin-top: 8px;
}

.blocks-footnote {
    color: var(--color-foreground-dim);
    font-size: 11px;
    white-space: normal;
    margin: 2px 4px 6px 4px;
}

/* The runtime's [Header] attributes exist for the default inspector; inside a titled card they
   would repeat the title, so the decorator strip is hidden here. */
.blocks-panel .unity-decorator-drawers-container {
    display: none;
}
