/* SegmentedControl: a dropdown whose choices are all visible. One row, one button on. */
.blocks-seg {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 21px;
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: 3px;
    background-color: var(--color-inset);
    overflow: hidden;
}

.blocks-seg > .blocks-seg__button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0 4px;
    border-width: 0 1px 0 0;
    border-radius: 0;
    border-color: var(--color-border-strong);
    background-color: var(--color-transparent);
    color: var(--color-foreground-secondary);
    font-size: 11.5px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.blocks-seg > .blocks-seg__button--last {
    border-right-width: 0;
}

.blocks-seg > .blocks-seg__button:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-foreground-strong);
}

.blocks-seg > .blocks-seg__button.blocks-seg__button--on {
    background-color: var(--color-accent);
    color: var(--color-accent-on);
}

.blocks-seg > .blocks-seg__button.blocks-seg__button--on:hover {
    background-color: var(--color-accent-bright);
}

/* Press feedback: the shared .unity-button:active rule loses to the hover rule above on specificity. */
.blocks-seg > .blocks-seg__button:active {
    background-color: var(--color-surface-subtle);
}

.blocks-seg > .blocks-seg__button.blocks-seg__button--on:active {
    background-color: var(--color-accent);
}
