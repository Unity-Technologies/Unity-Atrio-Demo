/* Transport: the strip at the top of an Interactable inspector. State dot, what the
   interactable is doing in one line, and Play / Stop. */
.blocks-transport {
    flex-direction: row;
    align-items: center;
    padding: 10px 10px 11px 14px;
    margin-bottom: 8px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border);
    background-color: var(--color-card-background);
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 200ms;
}

.blocks-transport--live {
    border-color: var(--color-live-background);
}

.blocks-transport__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: var(--color-foreground-dim);
    transition-property: background-color, scale, opacity;
    transition-duration: 200ms, 520ms, 520ms;
    transition-timing-function: ease-in-out;
}

.blocks-transport--ready .blocks-transport__dot   { background-color: var(--color-live); }
.blocks-transport--live .blocks-transport__dot    { background-color: var(--color-live); }
.blocks-transport--blocked .blocks-transport__dot { background-color: var(--color-warning); }

.blocks-transport--live .blocks-transport__dot.blocks-pulse {
    scale: 1.6;
    opacity: 0.35;
}

.blocks-transport__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.blocks-transport__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-foreground-strong);
}

.blocks-transport__sub {
    font-size: 11px;
    color: var(--color-foreground-muted);
    white-space: normal;
    margin-top: 1px;
}

.blocks-transport__buttons {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    flex-shrink: 0;
}

.blocks-transport__button {
    height: 26px;
    padding: 0 12px 0 9px;
    margin: 0 0 0 6px;
}

.blocks-transport__button .unity-button__image {
    width: 11px;
    height: 11px;
    margin-right: 5px;
}

/* Effect strip: the status line at the top of the Animator Driver inspector, naming the Animator
   it writes to. */
.blocks-effect-strip {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px 8px 2px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.blocks-effect-strip__eyebrow {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--color-foreground-dim);
}

.blocks-effect-strip__neighbors {
    font-size: 11px;
    color: var(--color-foreground-muted);
    margin-left: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}
