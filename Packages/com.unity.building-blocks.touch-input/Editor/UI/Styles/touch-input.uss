/* Touch Input's own composites, built on the copied Building Blocks tokens (core.uss / core-light.uss) so they
   read as the same family: labelled rows, values and hints, sliders, the control-kind icons, the one-line pointer. */

/* A label on a fixed column and the control after it (the mock's .row). */
.blocks-touch-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin: 2px 0;
}

.blocks-touch-row__label {
    width: 38%;
    min-width: 90px;
    flex-shrink: 0;
    padding: 0 6px 0 0;
    color: var(--color-foreground-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.blocks-touch-row__control {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.blocks-touch-row__control > .unity-base-field,
.blocks-touch-row__control > .unity-property-field {
    flex-grow: 1;
    margin: 0;
}

/* A field inside a row: the row's label is the label, so the field's own is hidden. */
.blocks-touch-row__field .unity-base-field__label {
    display: none;
}

.blocks-touch-row__field .unity-base-field {
    margin: 0;
    flex-grow: 1;
}

/* PropertyFields inside a card keep Unity's own label column; make it the same 38% as the rows. */
.blocks-panel .unity-base-field__label {
    min-width: 90px;
    width: 38%;
    color: var(--color-foreground-secondary);
}

.blocks-panel .unity-base-field__aligned .unity-base-field__label {
    width: 38%;
    min-width: 90px;
}

/* A read-only value in a field's frame. */
.blocks-touch-value {
    flex-grow: 1;
    height: 20px;
    padding: 0 6px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--color-border-subtle-strong);
    background-color: var(--color-surface-subtle);
    color: var(--color-foreground-secondary);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.blocks-touch-value--link:hover {
    border-color: var(--color-accent-border);
    color: var(--color-foreground-strong);
}

/* The small bold heading inside a card body: "Bindings on Move". */
.blocks-touch-sub {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--color-foreground-strong);
    margin: 8px 0 3px 0;
}

.blocks-touch-hint {
    color: var(--color-foreground-dim);
    font-size: 11px;
    white-space: normal;
    margin-top: 5px;
}

.blocks-touch-note {
    color: var(--color-live-text);
    font-size: 11px;
    white-space: normal;
    margin-top: 5px;
}

/* A slider with its number. */
.blocks-touch-slider {
    flex-grow: 1;
    margin: 0;
}

.blocks-touch-slider .unity-base-slider__input {
    margin-right: 4px;
}

.blocks-touch-slider .unity-base-slider__text-field {
    width: 46px;
    min-width: 46px;
    margin-left: 6px;
}

/* Small drawn icons for the control kinds, in the touch accent. */
.blocks-touch-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    border-width: 1.5px;
    border-color: rgb(214, 120, 30);
    border-radius: 7px;
    align-items: center;
    justify-content: center;
}

.blocks-touch-icon__dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgb(214, 120, 30);
}

.blocks-touch-icon--button .blocks-touch-icon__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

/* Several fixes on one finding: stacked on the right. */
.blocks-check__fixes {
    flex-direction: column;
    align-items: stretch;
    margin-left: 8px;
}

.blocks-check__fixes > .blocks-check__fix {
    margin-left: 0;
    margin-bottom: 3px;
}

/* The one-line pointer that replaces a sibling component's inspector. */
.blocks-touch-pointer {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 4px -2px;
}

.blocks-touch-pointer__text {
    color: var(--color-foreground-dim);
    font-size: 11px;
    margin-right: 6px;
}

/* Toggle rows in a card use the same label column. */
.blocks-panel .unity-toggle > .unity-toggle__input {
    flex-grow: 0;
}

/* The gloss is two or three words that say what a card is about; the summary gives way first. */
.blocks-panel__gloss {
    flex-shrink: 0;
}

/* A finding that is fine as is: grey, no tint. */
.blocks-check--info .blocks-check__icon {
    color: var(--color-foreground-dim);
}

.blocks-check--info .blocks-check__title {
    -unity-font-style: normal;
    color: var(--color-foreground-secondary);
}

/* The sentence under a card that stays when it is closed (the gameplay package's sum bar). */
.blocks-touch-sumbar {
    margin: 0;
    padding: 7px 12px;
    border-top-width: 1px;
    border-top-color: var(--color-divider);
    background-color: var(--color-accent-background-soft);
    color: var(--color-foreground-secondary);
    font-size: 11px;
    white-space: normal;
}

.blocks-touch-sumbar--warn {
    background-color: var(--color-warning-background);
    color: var(--color-warning-text);
}

.blocks-touch-sumbar--error {
    background-color: var(--color-danger-background);
    color: var(--color-danger-text);
}

/* Mappings card (Touch Rig): the gameplay step-group boxes, one per control, rows are the actions it drives. */
.blocks-mappings .blocks-step {
    cursor: link;
}

.blocks-mapping__control-icon {
    margin: 0 4px 0 4px;
}

.blocks-mapping__title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-foreground-strong);
    margin-left: 4px;
}

.blocks-mapping__meta {
    margin-right: 4px;
}

.blocks-mappings .blocks-step__glyph {
    margin-left: 6px;
}

.blocks-mappings .blocks-step__body {
    padding-left: 22px;
}

/* An action waiting for a control: amber box, the picker is the call to action. */
.blocks-beat--pending {
    border-color: var(--color-warning-text);
    background-color: var(--color-warning-background);
}

.blocks-beat--pending .blocks-mapping__title {
    color: var(--color-warning-text);
}

.blocks-beat--orphan .blocks-mapping__title {
    color: var(--color-foreground-muted);
}

.blocks-mapping__choose {
    height: 20px;
    margin: 0 2px 0 6px;
    padding: 0 8px;
    font-size: 11px;
    border-radius: 3px;
    flex-shrink: 0;
    color: var(--color-accent-text);
    border-color: var(--color-accent-border);
    background-color: var(--color-accent-background-soft);
}

.blocks-mapping__choose:hover {
    background-color: var(--color-accent-background);
}

.blocks-step--pending-choice .blocks-step__more {
    opacity: 1;
}

.blocks-mapping__live {
    font-size: 11px;
    color: var(--color-foreground-dim);
    margin-right: 4px;
}

.blocks-mapping__live--on {
    color: var(--color-live-text);
}

/* Joystick / Button inspector: what it drives, read-only, above Feel and Look. */
.blocks-touch-drives {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 8px 2px;
}

.blocks-touch-drives__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: var(--color-foreground-secondary);
    white-space: normal;
}

.blocks-touch-drives__text--none {
    color: var(--color-foreground-dim);
}

.blocks-touch-drives__edit {
    flex-shrink: 0;
}
